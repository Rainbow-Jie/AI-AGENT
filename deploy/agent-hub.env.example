# ============================================================
# Agent Hub 环境变量（复制到 /etc/agent-hub.env，chmod 600）
# 这个文件不要提交到 git，.gitignore 已经排除了
# ============================================================

# SQLite 数据文件位置（相对 WorkingDirectory=/opt/agent-hub）
AGENT_HUB_DB=./data/agent-hub.db

# 智能体读写文件、执行命令的根目录。给普通用户用的智能体建议 tool_mode=off
AGENT_HUB_WORKSPACE=./workspace

# 首次启动创建的管理员。数据库里已有用户时这两行不再生效
AGENT_HUB_ADMIN_USER=admin
# 留空 = 首次启动随机生成 12 位密码，只打印在 journalctl 里一次
AGENT_HUB_ADMIN_PASSWORD=

# 时区（jar 里也硬指定了，这里给 nginx / 子进程用）
TZ=Asia/Shanghai
